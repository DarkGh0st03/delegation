# PoC configuration template.
# Copy to a local .env file and fill values there. Do not commit real credentials.

GITEA_BASE_URL=http://gitea:3000
GITEA_OWNER=thesis
GITEA_REPOSITORY=iam-console-poc
GITEA_GATEWAY_CREDENTIAL=

GATEWAY_PORT=8080
GATEWAY_BIND_ADDR=0.0.0.0:8080
GATEWAY_AUDIENCE=cloud-access-gateway
GATEWAY_REQUEST_TTL_MS=120000
GATEWAY_RESOURCE_AUTHORITY=gitea.local
DELEGATION_ADAPTER_URL=http://delegation-adapter:8090
OPA_URL=http://opa:8181
ANVIL_RPC_URL=http://anvil:8545
TEST_RUNNER_URL=http://test-runner-controller:8095

ADAPTER_CALLER_ENGINEER=
ADAPTER_CALLER_GATEWAY=
ADAPTER_CALLER_ORCHESTRATOR=
ADAPTER_CALLER_BACKEND=
ADAPTER_CALLER_FRONTEND=
ADAPTER_CALLER_TEST=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
