# Optional host-process reference for the current delegation PoC (AUD-015).
# This file is NOT loaded automatically by Compose, the Gateway or the Adapter.
# Create the real, gitignored local configuration with:
#   node poc/scripts/init-local-env.mjs
#   bash poc/scripts/phase1-up.sh
# Those scripts generate poc/infra/.env and poc/infra/runtime/{gateway,runner,trust}.env.
# Use the generated credentials and contract addresses; do not commit secrets.
# Values below refer to services accessed from the HOST, not Docker DNS names.

GITEA_BASE_URL=http://127.0.0.1:3000
GITEA_OWNER=thesis
GITEA_REPOSITORY=iam-console-poc
GITEA_TIMEOUT_MS=3000

GATEWAY_BIND_ADDR=127.0.0.1:8080
GATEWAY_AUDIENCE=cloud-access-gateway
GATEWAY_REQUEST_TTL_MS=120000
GATEWAY_RESOURCE_AUTHORITY=gitea.local
GATEWAY_PROVIDER_MODE=gitea
DELEGATION_ADAPTER_URL=http://127.0.0.1:8090
OPA_URL=http://127.0.0.1:8181
OPA_TIMEOUT_MS=2000
TEST_RUNNER_URL=http://127.0.0.1:8095
TEST_RUNNER_TIMEOUT_MS=900000

# For an independently started EVM Adapter / Docker Runner:
ADAPTER_BIND_ADDR=127.0.0.1:8090
ADAPTER_TRUST_PROFILE=evm
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
TEST_RUNNER_BIND_ADDR=127.0.0.1:8095
TEST_RUNNER_TOTAL_TIMEOUT_MS=840000

# Required private values (NOT placeholders to overwrite generated secrets):
# - ADAPTER_CALLER_ENGINEER/GATEWAY/ORCHESTRATOR/BACKEND/FRONTEND/TEST:
#     generated by poc/scripts/init-local-env.mjs in poc/infra/.env
# - GITEA_GATEWAY_TOKEN: generated in poc/infra/runtime/gateway.env
# - GITEA_RUNNER_TOKEN: generated in poc/infra/runtime/runner.env
# - TEST_RUNNER_GATEWAY_TOKEN: shared private Gateway->Runner authentication
# - DID/enterprise/issuer registry addresses: poc/infra/runtime/trust.env
# Additional service-specific inputs are defined by each service's config.
# Gemini paid E2E uses its own manual workflow; this is not its configuration.
