{
  "name": "delegation-thesis-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.15.0",
    "npm": "10.9.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "local:prepare": "bash ./scripts/local-prepare.sh",
    "console": "node ./engineer-console/src/server.mjs",
    "console:user": "node ./engineer-console/scripts/create-user.mjs",
    "console:test": "node --test ./engineer-console/test/*.test.mjs",
    "gateway:test": "npm run test -w @thesis/gateway",
    "agent-runtime:test": "npm run test -w @thesis/agent-runtime",
    "orchestrator-runtime:test": "npm run test -w @thesis/orchestrator-runtime",
    "runner:test": "npm run test -w @thesis/test-runner-controller",
    "orchestrator:test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test ./apps/orchestrator/test/*.test.mjs",
    "plan-contracts:test": "node --test ./packages/plan-contracts/test/*.test.mjs",
    "opa:test": "bash ./scripts/opa-policy-test.sh"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "express": "5.1.0"
  }
}
