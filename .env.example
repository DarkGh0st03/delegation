# Copy this file to ".env" (same folder) and choose your password.
# ".env" is ignored by Git: it never leaves your computer.

# Engineer login for the console at http://127.0.0.1:8700
ENGINEER_USERNAME=engineer
ENGINEER_PASSWORD=

# Gemini (PAID): the agents' model. Required to start sessions.
# The key is passed only to the "app" service; never paste it in a chat.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Import source: repositories can be imported ONLY from this GitHub account.
GITHUB_OWNER=DarkGh0st03
# Optional, read-only (fine-grained, "Contents: read") token to import
# private repositories. Leave empty for public ones. Never paste it in a chat.
GITHUB_TOKEN=
