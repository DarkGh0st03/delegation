# Copy this file to ".env" (same folder) and choose your password.
# ".env" is ignored by Git: it never leaves your computer.

# Engineer login for the console at http://127.0.0.1:8700
ENGINEER_USERNAME=engineer
ENGINEER_PASSWORD=

# Gemini (OPTIONAL, PAID). Leave empty to use only the free modes.
# The key is passed only to the "app" service; never paste it in a chat.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
